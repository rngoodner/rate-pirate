# Server
PORT=3789
DB_PATH=./data/rate-pirate.db

# Flight price provider: "google-flights" (live — scrapes Google Flights via
# headless Chrome) or "mock" (demo mode: auto-seeds 14 days of synthetic history
# across all cabins and trip types on boot so the UI is populated). Switching to
# google-flights purges all mock data on boot; switching to mock reseeds it. The
# two never mix.
PROVIDER=google-flights

# Chrome/Chromium path for google-flights. Auto-detected on macOS (Google
# Chrome) and Debian (apt install chromium); set only to override.
CHROME_PATH=
# Set true only if Chromium refuses to launch sandboxed (containers, unusual
# kernels). Watch the Activity log after deploys — launch failures show there.
CHROME_NO_SANDBOX=false

# --- Email ---
# Sender precedence: SMTP (if SMTP_HOST set) > Resend (if RESEND_API_KEY set) > console log.
# ALERT_EMAIL_FROM is the From address for whichever sender is active.
ALERT_EMAIL_FROM=you@proton.me

# SMTP — e.g. Proton Bridge running on this host (see README "Email via Proton Bridge").
# Bridge exposes a local STARTTLS SMTP server with a self-signed cert, so:
#   SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_SECURE=false  SMTP_ALLOW_INVALID_CERT=true
#   SMTP_USER = your Proton address, SMTP_PASS = the Bridge-generated password (not your login).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_ALLOW_INVALID_CERT=true

# Resend (https://resend.com) — fallback if SMTP is not configured. Without a verified
# domain, from must be onboarding@resend.dev and delivery only reaches the account owner.
RESEND_API_KEY=

# Default alert recipient(s) — comma-separated for multiple; also editable in Settings.
ALERT_EMAIL_TO=
