# Server
PORT=3789
DB_PATH=./data/rate-pirate.db

# Flight price provider: "google-flights", "travelpayouts", or "mock".
# google-flights is the primary provider (Travelpayouts has ~no ABQ-origin data).
PROVIDER=google-flights

# google-flights scrapes via headless Chrome/Chromium. Auto-detected on
# macOS (Google Chrome) and Debian (apt install chromium); override here if needed.
CHROME_PATH=

# Travelpayouts / Aviasales Data API (optional fallback provider)
TRAVELPAYOUTS_TOKEN=

# Resend (https://resend.com) — without a verified domain, from must be onboarding@resend.dev
RESEND_API_KEY=
ALERT_EMAIL_FROM=onboarding@resend.dev

# Default alert recipient (also editable in the app's Settings UI)
ALERT_EMAIL_TO=
