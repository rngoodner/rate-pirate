# Server
PORT=3789
DB_PATH=./data/rate-pirate.db

# Flight price provider: "google-flights" (primary — scrapes Google Flights via
# headless Chrome), "travelpayouts" (fallback; ~no ABQ-origin data), or "mock"
# (demo mode: auto-seeds 14 days of synthetic history on boot so the UI is
# populated). Switching back to a real provider purges all mock data on boot.
PROVIDER=google-flights

# Chrome/Chromium path for google-flights. Auto-detected on macOS (Google
# Chrome) and Debian (apt install chromium); set only to override.
CHROME_PATH=

# Travelpayouts / Aviasales Data API token (only needed for PROVIDER=travelpayouts)
TRAVELPAYOUTS_TOKEN=

# Resend (https://resend.com) — without a verified domain, from must be
# onboarding@resend.dev and delivery only works to the account owner's address.
RESEND_API_KEY=
ALERT_EMAIL_FROM=onboarding@resend.dev

# Default alert recipient (also editable in the app's Settings UI)
ALERT_EMAIL_TO=
