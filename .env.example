# Server
PORT=3789
DB_PATH=./data/rate-pirate.db

# Flight price provider: "travelpayouts" or "mock" (defaults to mock when the token is absent)
PROVIDER=mock

# Travelpayouts / Aviasales Data API (free token from https://www.travelpayouts.com)
TRAVELPAYOUTS_TOKEN=

# Resend (https://resend.com) — without a verified domain, from must be onboarding@resend.dev
RESEND_API_KEY=
ALERT_EMAIL_FROM=onboarding@resend.dev

# Default alert recipient (also editable in the app's Settings UI)
ALERT_EMAIL_TO=
