# systemd unit for Rate Pirate — install on your-server.local:
#   # Requires: apt install chromium (for the google-flights provider)
#   sudo cp deploy/rate-pirate.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rate-pirate
[Unit]
Description=Rate Pirate flight deal monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ryan
WorkingDirectory=/opt/rate-pirate
EnvironmentFile=/opt/rate-pirate/.env
ExecStart=/usr/bin/npm -w server run start
Restart=always
RestartSec=5
# Contain a ballooning headless Chromium (Google Flights pages are heavy) —
# systemd kills the whole cgroup on breach and Restart=always recovers.
MemoryHigh=1536M
MemoryMax=2G
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
